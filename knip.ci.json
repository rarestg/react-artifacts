{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/artifacts/*/index.tsx", "src/artifacts/*/meta.ts", "tests/**/*.{test,spec}.ts"],
  "project": ["src/**/*.{ts,tsx,css}", "worker/**/*.ts", "tests/**/*.ts", "!**/*.d.ts", "!dist/**", "!.wrangler/**"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "warn",
    "duplicates": "warn"
  },
  "typescript": {
    "config": ["tsconfig.json"]
  },
  "ignoreIssues": {
    "src/artifacts/sharp2/conversation/index.ts": ["types"]
  }
}
